{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    /* The maintained scripts (../scripts/*.mjs) are checked as JavaScript against the colony's types, so a rename in the
       core fails `tsc -b` here instead of failing when someone next runs the script. scripts/lab holds one-off
       measurements and is not checked. Not strict: the scripts are untyped glue, and the point is the core's names. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["../scripts/*.mjs"],
  "exclude": ["../scripts/e2e-one-world.mjs"]
}
