{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --config .prettierrc.json --ignore-path ../.prettierignore --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"worker/**/*.ts\" \"shared/*.ts\" \"*.ts\" \"../scripts/**/*.mjs\"",
    "format:check": "prettier --config .prettierrc.json --ignore-path ../.prettierignore --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"worker/**/*.ts\" \"shared/*.ts\" \"*.ts\" \"../scripts/**/*.mjs\"",
    "typecheck": "tsc -b",
    "test": "node --test --test-timeout=120000 server/tests/*.test.ts worker/tests/*.test.ts src/ui/tests/*.test.ts src/colony/tests/unit/*.test.ts src/ui/tests/int/*.test.ts src/colony/tests/int/*.test.ts src/colony/tests/soak/*.test.ts src/colony/tests/golden/*.test.ts",
    "test:unit": "node --test --test-timeout=60000 server/tests/*.test.ts worker/tests/*.test.ts src/ui/tests/*.test.ts src/colony/tests/unit/*.test.ts",
    "test:watch": "node --test --watch --test-timeout=60000 server/tests/*.test.ts worker/tests/*.test.ts src/ui/tests/*.test.ts src/colony/tests/unit/*.test.ts",
    "test:int": "node --test --test-timeout=60000 src/ui/tests/int/*.test.ts src/colony/tests/int/*.test.ts",
    "test:soak": "node --test --test-timeout=120000 src/colony/tests/soak/*.test.ts",
    "test:golden": "node --test --test-timeout=60000 src/colony/tests/golden/*.test.ts",
    "preview": "vite preview",
    "test:slow": "node --test --test-timeout=1200000 src/colony/tests/slow/*.test.ts",
    "e2e": "node ../scripts/e2e-one-world.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
