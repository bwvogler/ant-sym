{
  "name": "jev-ants",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Two colonies of ants and a fungus on one map, each ant steered by a Jev decision",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "test": "npm --prefix web test",
    "test:unit": "npm --prefix web run test:unit",
    "test:watch": "npm --prefix web run test:watch",
    "test:int": "npm --prefix web run test:int",
    "test:soak": "npm --prefix web run test:soak",
    "test:golden": "npm --prefix web run test:golden",
    "test:slow": "npm --prefix web run test:slow",
    "lint": "npm --prefix web run lint && web/node_modules/.bin/oxlint -c web/.oxlintrc.json --ignore-pattern 'scripts/lab/**' scripts",
    "format": "npm --prefix web run format",
    "format:check": "npm --prefix web run format:check",
    "typecheck": "npm --prefix web run typecheck",
    "colony-bench": "node scripts/colony-bench.mjs",
    "colony-cost": "node scripts/colony-cost.mjs",
    "exp": "node scripts/experiment.mjs",
    "e2e": "node scripts/e2e-one-world.mjs"
  }
}
