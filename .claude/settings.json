{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/beads-sync.sh start; command -v bd >/dev/null 2>&1 && bd prime --hook-json || true",
            "type": "command",
            "timeout": 300
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/beads-sync.sh push",
            "type": "command",
            "async": true
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/slow-dispatch.sh",
            "type": "command"
          }
        ],
        "matcher": "mcp__github__actions_run_trigger"
      }
    ]
  }
}
